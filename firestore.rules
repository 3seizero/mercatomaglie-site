rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Ruolo: custom claim oppure documento staff/{uid} (gestito dal pannello admin)
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    // Utente disattivato (attivo == false) o senza ruolo -> null. 'role' in token evita l'errore sui claim assenti.
    function staffRole() {
      let d = staffDoc().data;
      return d.get('attivo', true) == false ? null : d.get('role', null);
    }
    function role() {
      return !signedIn() ? null
        : (('role' in request.auth.token) ? request.auth.token.role
        : (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ? staffRole() : null));
    }
    function isAdmin() { return role() == 'admin'; }
    function isSuap() { return role() in ['admin', 'suap']; }
    function isStaff() { return role() in ['admin', 'operatore', 'suap']; }
    // Le presenze le certificano solo gli operatori di controllo (admin incluso per assistenza tecnica)
    function isOperatore() { return role() in ['admin', 'operatore']; }

    // Dati pubblici: lettura libera, scrittura admin/suap
    match /mercati/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /posteggi/{id}    { allow read: if true; allow write: if isSuap(); }
    match /espositori/{id}  { allow read: if true; allow write: if isSuap(); }
    match /eventi/{id}      { allow read: if true; allow write: if isAdmin(); }
    // Riassunti per l'app pubblica (1 lettura per mercato)
    match /pubblico/{mercatoId} { allow read: if true; allow write: if isSuap(); }
    match /stato/{mercatoId}    { allow read: if true; allow write: if isOperatore(); }
    // Impostazioni per mercato (ora limite spunta, azzeramento, assenze massime) e calendario (giornate spostate/soppresse)
    match /impostazioni/{mercatoId} { allow read: if true; allow write: if isSuap(); }
    match /calendario/{id}          { allow read: if true; allow write: if isSuap(); }

    // QR: token → espositore. Leggibile da chi conosce il token; scritto da admin/suap.
    match /qr/{token} { allow get: if true; allow list: if isSuap(); allow write: if isSuap(); }

    // Dati riservati (CF, P.IVA, indirizzi, token QR): solo admin e suap
    match /espositori_riservati/{id} { allow read, write: if isSuap(); }

    // Presenze certificate: create/annullamento dallo staff (la riga resta), cancellazione solo admin
    match /presenze/{id} {
      allow read: if isStaff();
      allow create, update: if isOperatore();
      allow delete: if isAdmin();
    }

    // Richieste self-service degli espositori (dal link QR): chiunque può crearne una con i soli campi ammessi;
    // lettura, approvazione e cancellazione solo admin/suap.
    match /richieste/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token','espositoreId','alias','referente','whatsapp','telegram','descrizione','consenso','creato','stato'])
                    && request.resource.data.consenso == true && request.resource.data.token is string && request.resource.data.stato == 'in-attesa';
      allow read, update, delete: if isSuap();
    }

    // Staff: uid → ruolo e anagrafica. Lettura: admin/suap (report) o l'interessato. Scrittura: admin.
    match /staff/{uid} {
      allow read: if isSuap() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
