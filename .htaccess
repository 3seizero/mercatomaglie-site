# Area Mercatale Maglie: header per la PWA (vale con Apache; Plesk lo applica anche dietro nginx)
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|workbox-.*\.js|index\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw\.js|registerSW\.js|workbox-.*\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# Indirizzi scritti a mano: /App, /ADMIN, /app (senza barra) → percorso corretto
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app/?$ /app/ [R=301,L,NC]
  RewriteRule ^admin/?$ /admin/ [R=301,L,NC]
  RewriteRule ^app/(.*)$ /app/$1 [R=301,L,NC]
  RewriteRule ^admin/(.*)$ /admin/$1 [R=301,L,NC]
</IfModule>
