# Area Mercatale Maglie: header per la PWA (vale con Apache; Plesk lo applica anche dietro nginx)
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|workbox-.*\.js|index\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw\.js|registerSW\.js|workbox-.*\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>
